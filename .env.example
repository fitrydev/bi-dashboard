# Salin file ini menjadi .env.local dan isi nilainya. JANGAN commit .env.local.

# URL project Supabase (lokal: http://127.0.0.1:54321 setelah `bunx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (aman untuk browser). Boleh pakai prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key: HANYA server, JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Kredensial Google OAuth. Dipakai oleh Supabase CLI untuk instance LOKAL saja
# (lewat supabase/config.toml). Tidak dibaca oleh aplikasi Next.js.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
